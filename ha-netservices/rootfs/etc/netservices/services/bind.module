SERVICE_ID="bind"
SERVICE_NAME="BIND"
SERVICE_TOGGLE_KEY="enable_bind"
SERVICE_RUNTIME_DIR="/config/ha-netservices/bind9"
SERVICE_DEFAULTS_DIR="/etc/defaults/bind9"
SERVICE_START_CMD="/usr/sbin/named -g -c /config/ha-netservices/bind9/named.conf"
SERVICE_VALIDATE_CMD="/usr/sbin/named-checkconf /config/ha-netservices/bind9/named.conf"
SERVICE_HEALTH_CMD="/usr/bin/dig @127.0.0.1 -p 53 localhost +short >/dev/null"
SERVICE_PRIORITY="20"
