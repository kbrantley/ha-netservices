SERVICE_ID="mgmt"
SERVICE_NAME="Management API"
SERVICE_TOGGLE_KEY="enable_mgmt"
SERVICE_RUNTIME_DIR="/config/ha-netservices/mgmt"
SERVICE_DEFAULTS_DIR="/etc/defaults/mgmt"
SERVICE_START_CMD="/usr/local/bin/mgmt"
SERVICE_VALIDATE_CMD="/usr/local/bin/mgmt --version >/dev/null 2>&1"
SERVICE_HEALTH_CMD="/bin/nc -z 127.0.0.1 8099"
SERVICE_PRIORITY="5"
