SERVICE_ID="haproxy"
SERVICE_NAME="HAProxy"
SERVICE_TOGGLE_KEY="enable_haproxy"
SERVICE_RUNTIME_DIR="/config/ha-netservices/haproxy"
SERVICE_DEFAULTS_DIR="/etc/defaults/haproxy"
SERVICE_START_CMD="/usr/sbin/haproxy -W -db -f /config/ha-netservices/haproxy/haproxy.cfg"
SERVICE_VALIDATE_CMD="/usr/sbin/haproxy -c -f /config/ha-netservices/haproxy/haproxy.cfg"
SERVICE_HEALTH_CMD="/bin/nc -z 127.0.0.1 80"
SERVICE_PRIORITY="10"
