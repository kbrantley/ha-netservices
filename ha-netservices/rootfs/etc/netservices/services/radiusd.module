SERVICE_ID="radiusd"
SERVICE_NAME="FreeRADIUS"
SERVICE_TOGGLE_KEY="enable_radiusd"
SERVICE_RUNTIME_DIR="/config/ha-netservices/radiusd"
SERVICE_DEFAULTS_DIR="/etc/defaults/radiusd"
SERVICE_START_CMD="/usr/sbin/radiusd -f -l stdout -d /config/ha-netservices/radiusd"
SERVICE_VALIDATE_CMD="/usr/sbin/radiusd -C -d /config/ha-netservices/radiusd"
SERVICE_HEALTH_CMD="/bin/pgrep -x radiusd >/dev/null"
SERVICE_PRIORITY="30"
